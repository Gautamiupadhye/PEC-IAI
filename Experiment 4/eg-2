# Best First Search
# Start State: A
# Goal State: P

import heapq

# Graph with heuristic values
graph = {
    'A': [('B', 4), ('C', 4), ('D', 6)],
    'B': [('E', 5), ('F', 5)],
    'C': [('G', 4), ('H', 3)],
    'D': [('I', 999), ('J', 999)],
    'E': [('T', 5)],
    'F': [('R', 4)],
    'G': [('N', 999)],
    'H': [('O', 2), ('P', 3)],
    'I': [('Q', 999)],
    'J': [('R', 4)],
    'O': [],
    'P': [],
    'T': [],
    'R': [],
    'N': [],
    'Q': []
}

start = 'A'
goal = 'P'

# Priority queue
open_list = []
heapq.heappush(open_list, (0, start))

closed = set()
parent = {start: None}

while open_list:

    # Get node with lowest heuristic value
    heuristic, current = heapq.heappop(open_list)

    if current in closed:
        continue

    print("Selected:", current, "Heuristic:", heuristic)

    closed.add(current)

    # Check goal
    if current == goal:
        print("\nGoal state found!")
        break

    # Expand current node
    for child, h in graph[current]:

        if child not in closed:
            if child not in parent:
                parent[child] = current

            heapq.heappush(open_list, (h, child))

else:
    print("Goal state not found!")


# Find path from start to goal
if goal in parent:

    path = []
    node = goal

    while node is not None:
        path.append(node)
        node = parent[node]

    path.reverse()

    print("\nPath:", " -> ".join(path))